DATABASE_URL="postgresql://neondb_owner:replace_with_your_neon_password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Legacy fields retained from the previous sign-in flow; database sign-in ignores them.
SUPER_ADMIN_EMAIL="abc@gmail.com"
SUPER_ADMIN_PASSWORD_HASH="replace_with_scrypt_salt_and_hash"
# Used only to sign session cookies. Generate a unique random value for each deployment.
AUTH_SECRET="replace_with_a_long_random_secret"
# Read-only analytics copilot. Keep these server-side; never expose them to the browser.
# Google is the default provider. Gemma 4 supports the assistant's database tool calls.
LLM_PROVIDER="google"
GEMINI_API_KEY="replace_with_google_ai_studio_key"
GOOGLE_MODEL="gemma-4-26b-a4b-it"
# Alternative Google model examples: gemma-4-31b-it, gemini-2.5-flash

# Optional Groq fallback:
GROQ_API_KEY="replace_with_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"
