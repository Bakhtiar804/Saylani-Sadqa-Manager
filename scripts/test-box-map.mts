import assert from 'node:assert/strict';
import { performance } from 'node:perf_hooks';
import { parseBoxCoordinates, hasBoxCoordinates } from '../lib/box-coordinates';
import { buildBoxPoints, getMapBoxes, cityMapBounds, PAKISTAN_BOUNDS } from '../lib/box-map';
import type { NetworkCity } from '../lib/network-tree';

assert.deepEqual(parseBoxCoordinates({}), { latitude: null, longitude: null });
assert.deepEqual(parseBoxCoordinates({ latitude: '', longitude: null }), { latitude: null, longitude: null });
assert.deepEqual(parseBoxCoordinates({ latitude: '24.8607345', longitude: '67.0011234' }), { latitude: 24.860735, longitude: 67.001123 });
assert.deepEqual(parseBoxCoordinates({ latitude: 0, longitude: 0 }), { latitude: 0, longitude: 0 });
for (const input of [{ latitude: 91, longitude: 67 }, { latitude: 24, longitude: -181 }, { latitude: ' ', longitude: 67 }, { latitude: true, longitude: 67 }, { latitude: 24 }, { latitude: 24, longitude: '' }, { latitude: 'Infinity', longitude: 67 }, { latitude: [24], longitude: 67 }]) assert.throws(() => parseBoxCoordinates(input));
assert.equal(hasBoxCoordinates({ latitude: null, longitude: null }), false);
const cities: NetworkCity[] = [{ id: 'KHI', name: 'Karachi', registeredBoxes: 40001, reportedBoxes: 90000, month: '2026-11', areas: [{ name: 'Gulshan', boxes: Array.from({ length: 40000 }, (_, index) => ({ id: `BOX-${index}`, qr: `QR-${index}`, status: index % 2 ? 'Active' : 'Damaged', location: 'Verified fixture location', rider: null, latitude: 24.8 + (index % 100) * .001, longitude: 67 + Math.floor(index / 100) * .001 })) }, { name: 'Pending area', boxes: [{ id: 'PENDING', qr: 'QR-PENDING', status: 'Active', location: 'Address without GPS', rider: null }] }] }, { id: 'LHR', name: 'Lahore', registeredBoxes: 1, reportedBoxes: null, month: null, areas: [{ name: 'Town', boxes: [{ id: 'LAHORE', qr: 'QR-LHR', status: 'Active', location: 'Fixture', rider: null, latitude: 31.55, longitude: 74.34 }] }] }];
const start = performance.now();
const boxes = getMapBoxes(cities, 'KHI'), points = buildBoxPoints(boxes);
assert.equal(boxes.length, 40001); assert.equal(points.features.length, 40000);
assert.equal(new Set(points.features.map(feature => feature.id)).size, 40000);
assert.deepEqual(points.features[0].geometry.coordinates, [67, 24.8]);
assert.equal(getMapBoxes(cities, 'all').length, 40002);
assert.equal(buildBoxPoints(getMapBoxes(cities, 'all')).features.length, 40001);
assert.equal(getMapBoxes(cities, 'KHI', '', 'Active').length, 20001);
assert.equal(getMapBoxes(cities, 'KHI', 'BOX-39999').length, 1);
assert.equal(getMapBoxes(cities, 'KHI', 'Lahore').length, 0);
assert.equal(getMapBoxes(cities, 'unknown').length, 0);
assert.deepEqual(cityMapBounds(undefined, boxes), PAKISTAN_BOUNDS);
const khi = cityMapBounds(cities[0], []);
assert.ok(khi[0][0] < 67.01 && khi[1][0] > 67.01 && khi[0][1] < 24.86 && khi[1][1] > 24.86);
const fitted = cityMapBounds(cities[0], boxes);
assert.ok(fitted[0][0] <= 67 && fitted[1][0] >= 67.399);
console.log(`PASS 40,000 unique GPS dots without sampling, pending GPS exclusion, longitude/latitude order, city/search/status scope and Pakistan/city bounds (${Math.round(performance.now() - start)}ms).`);
