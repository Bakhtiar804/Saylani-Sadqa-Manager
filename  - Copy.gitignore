/.next/
/out/
/build/
/dist/
/.vercel/
/.turbo/

# Test output
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Logs and local database files/backups
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.sql.gz

# Operating-system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*.orig

# TypeScript and Next.js generated files
*.tsbuildinfo
next-env.d.ts
